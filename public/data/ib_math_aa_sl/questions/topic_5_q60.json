      ],
      "solution": "$\\int \\frac{2}{5x-1}\\,dx = \\frac{2}{5}\\ln|5x-1| + c$",
      "ai_explanation": {
        "concept_rule": "Integration of reciprocal linear functions: $\\int \\frac{k}{ax+b}\\,dx = \\frac{k}{a}\\ln|ax+b| + c$.",
