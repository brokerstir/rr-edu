        {
          "code": "M1",
          "desc": "Applying linearity to express equation in terms of $k$"
        },
        {
          "code": "A1",
          "desc": "Forming linear equation $2k + 4 = 10$"
        },
        {
          "code": "A1",
          "desc": "Solving for $k = 3$"
        }
      ],
      "solution": "$\\int_0^2 (kf(x) + 2)\\,dx = 10 \\implies \\int_0^2 kf(x)\\,dx + \\int_0^2 2\\,dx = 10 \\implies k\\int_0^2 f(x)\\,dx + 2(2-0) = 10 \\implies k(2) + 4 = 10 \\implies 2k + 4 = 10 \\implies 2k = 6 \\implies k = 3$",
      "ai_explanation": {
        "concept_rule": "Use linearity properties of definite integrals to form and solve an algebraic equation.",
        "step_by_step": [
          "Split the integral into $k\\int_0^2 f(x)\\,dx + \\int_0^2 2\\,dx = 10$.",
          "Substitute $\\int_0^2 f(x)\\,dx = 2$ and $\\int_0^2 2\\,dx = 4$.",
          "Solve $2k + 4 = 10$ for $k$."
        ],
        "common_pitfalls": "Treating $\\int_0^2 2\\,dx$ as $2$ instead of $2(2 - 0) = 4$."
      }
    }
