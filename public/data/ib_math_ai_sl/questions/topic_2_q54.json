          "code": "A1",
          "desc": "Obtain $b = 1300$"
        }
      ],
      "solution": "From $a + b = 2500$ and $a = 1200$, $b = 2500 - 1200 = 1300$.",
      "ai_explanation": {
        "concept_rule": "Substitute the value of $a$ into one of the linear equations to find $b$.",
        "step_by_step": [
