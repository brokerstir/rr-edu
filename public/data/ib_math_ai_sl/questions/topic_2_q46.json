  "question_number": 46,
  "question_text": "If $f(x) = 2 \\times 3^{-x}$, find:",
  "has_diagram": false,
  "subparts": [
    {
      "subpart": "a",
      "stem": "$f(0)$",
      "final_answer": "$2$",
      "mark_breakdown": [
        {
          "code": "M1",
          "desc": "Substitute $x = 0$ into $f(x)$"
        },
        {
          "code": "A1",
          "desc": "Evaluate to obtain 2"
        }
      ],
      "solution": "$f(0) = 2 \\times 3^0 = 2$",
      "ai_explanation": {
        "concept_rule": "Any non-zero number to the power of 0 is 1: $b^0 = 1$.",
        "step_by_step": [
          "Replace $x$ with $0$: $f(0) = 2 \\times 3^{-0} = 2 \\times 3^0$.",
          "Evaluate $3^0 = 1$, giving $2 \\times 1 = 2$."
        ],
        "common_pitfalls": "Mistakenly evaluating $3^0$ as $0$."
      }
    },
    {
      "subpart": "b",
      "stem": "$f(1)$",
      "final_answer": "$\\frac{2}{3}$",
      "mark_breakdown": [
        {
          "code": "M1",
          "desc": "Substitute $x = 1$ into $f(x)$"
        },
        {
          "code": "A1",
          "desc": "Simplify negative exponent"
        }
      ],
      "solution": "$f(1) = 2 \\times 3^{-1} = \\frac{2}{3}$",
      "ai_explanation": {
        "concept_rule": "Negative exponent rule: $b^{-n} = \\frac{1}{b^n}$.",
        "step_by_step": [
          "Substitute $x = 1$: $f(1) = 2 \\times 3^{-1}$.",
          "Write $3^{-1} = \\frac{1}{3}$.",
          "Multiply: $2 \\times \\frac{1}{3} = \\frac{2}{3}$."
        ],
        "common_pitfalls": "Writing $2 \\times 3^{-1}$ as $(2 \\times 3)^{-1} = \\frac{1}{6}$."
      }
    },
    {
      "subpart": "c",
      "stem": "$f(-2)$",
      "final_answer": "$18$",
      "mark_breakdown": [
        {
          "code": "M1",
          "desc": "Substitute $x = -2$ into $f(x)$"
        },
        {
          "code": "A1",
          "desc": "Evaluate the power and product"
        }
      ],
      "solution": "$f(-2) = 2 \\times 3^2 = 18$",
      "ai_explanation": {
        "concept_rule": "Substituting a negative number into a negative power gives a positive exponent: $-(-2) = 2$.",
        "step_by_step": [
          "Substitute $x = -2$: $f(-2) = 2 \\times 3^{-(-2)} = 2 \\times 3^2$.",
          "Compute $3^2 = 9$.",
          "Compute $2 \\times 9 = 18$."
        ],
        "common_pitfalls": "Sign error resulting in $3^{-2} = \\frac{1}{9}$."
      }
    }
  ]
}